import React, { useState } from 'react';
import { ScrollView, StyleSheet, Text, TouchableOpacity, View } from 'react-native';
import { colors } from '../constants/colors';
import type { ClassItem } from './ConfirmClassesScreen';
import type { NewPlannerItem } from './AddNewItemScreen';
export type Commitment = { id: string; name: string; days: string[]; startTime: string; endTime: string; weekly: boolean };
type Props = { classes?: ClassItem[]; commitments?: Commitment[]; plannerItems?: NewPlannerItem[]; onOpenClass?: (name: string) => void; onOpenAssignment?: (title: string, className: string) => void; onOpenTest?: (className: string, title?: string) => void; onOpenMonth?: () => void; onOpenTasks?: () => void; onAddItem?: () => void; onToggleItem?: (id: string) => void; onOpenMore?: () => void; onOpenAI?: () => void; onEditClasses?: () => void; onEditCommitments?: () => void };
const DAY_CODES = ['', 'M', 'T', 'W', 'R', 'F', ''] as const;
function dateKey(d: Date) { return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; }
function readableDate(value?: string) { if (!value) return 'No due date'; const p = value.split('-').map(Number); if (p.length !== 3 || p.some(Number.isNaN)) return value; return new Date(p[0], p[1] - 1, p[2]).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); }
function minutes(value?: string) { const match = (value ?? '').trim().match(/^(\d{1,2})(?::(\d{2}))?\s*(AM|PM)?$/i); if (!match) return 9999; let h = Number(match[1]); const m = Number(match[2] ?? 0); if (m > 59 || h > 23) return 9999; const suffix = match[3]?.toUpperCase(); if (suffix) { if (h < 1 || h > 12) return 9999; h = h % 12 + (suffix === 'PM' ? 12 : 0); } return h * 60 + m; }
function meets(course: ClassItem, date: Date) {
    const day = date.getDay();
    if (day === 0 || day === 6) return false;
    // Only render classes belonging to the selected date's semester.
    const key = dateKey(date);
    const semester = key >= '2026-08-12' && key <= '2026-12-17' ? 1
        : key >= '2027-01-05' && key <= '2027-05-20' ? 2 : null;
    if (semester === null) return false;
    if (course.semester != null && Number(course.semester) !== semester) return false;
    const days = course.meetingDays ?? [];
    const code = DAY_CODES[day];
    // If no meeting days were imported, treat the class as a weekday class.
    return days.length === 0 || (!!code && days.some(d => d === code));
}
function commitmentMeets(c: Commitment, date: Date) { const aliases = [['sunday', 'sun', 'su'], ['monday', 'mon', 'm'], ['tuesday', 'tue', 'tues', 'tu', 't'], ['wednesday', 'wed', 'w'], ['thursday', 'thu', 'thur', 'thurs', 'th', 'r'], ['friday', 'fri', 'f'], ['saturday', 'sat', 'sa']]; return c.days.some(d => aliases[date.getDay()].includes(d.trim().toLowerCase())); }
export default function PlannerScreen({ classes = [], commitments = [], plannerItems = [], onOpenClass, onOpenAssignment, onOpenTest, onOpenMonth, onOpenTasks, onAddItem, onToggleItem, onOpenMore, onOpenAI, onEditClasses, onEditCommitments }: Props) {
    const [selectedDate, setSelectedDate] = useState(new Date()); const [viewMode, setViewMode] = useState<'Day' | 'Week'>('Day');
    const selectedKey = dateKey(selectedDate); const todayKey = dateKey(new Date());
    const weekStart = new Date(selectedDate); weekStart.setDate(weekStart.getDate() - ((weekStart.getDay() + 6) % 7));
    const weekDays = Array.from({ length: 7 }, (_, i) => { const d = new Date(weekStart); d.setDate(d.getDate() + i); return d; });
    const changeWeek = (delta: number) => setSelectedDate(previous => { const next = new Date(previous); next.setDate(next.getDate() + delta * 7); return next; });
    const blocks = [
        ...classes.filter(c => meets(c, selectedDate)).map(c => ({ id: 'class-' + c.id, title: c.name, subtitle: c.period, time: c.startTime && c.endTime ? `${c.startTime} – ${c.endTime}` : 'Time not set', color: c.color, start: minutes(c.startTime) === 9999 ? 600 + (Number(c.period.match(/\d+/)?.[0] ?? 99) * 60) : minutes(c.startTime), isClass: true, classId: c.id })),
        ...commitments.filter(c => commitmentMeets(c, selectedDate) && minutes(c.startTime) !== 9999).map(c => ({ id: 'commitment-' + c.id, title: c.name, subtitle: c.weekly ? 'Extracurricular · Weekly' : 'Extracurricular', time: c.startTime && c.endTime ? `${c.startTime} – ${c.endTime}` : 'Time not set', color: colors.blocks.green, start: minutes(c.startTime), isClass: false, classId: '' }))
    ].sort((a, b) => a.start - b.start);
    const completed = plannerItems.filter(i => i.completed).length;
    const classItems = (id: string) => plannerItems.filter(i => i.classId === id && i.type !== 'event').sort((a, b) => (a.dueDate || '9999').localeCompare(b.dueDate || '9999'));


    return <View style={s.screen}><ScrollView contentContainerStyle={s.content}>
        <View style={s.header}><Text style={s.logo}>Flux</Text><TouchableOpacity onPress={onOpenMore} style={s.avatar}><Text style={s.avatarText}>T</Text></TouchableOpacity></View>
        <Text style={s.eyebrow}>{selectedDate.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }).toUpperCase()}</Text><Text style={s.title}>Your day, in flow.</Text><Text style={s.subtitle}>A little progress goes a long way.</Text>
        <View style={s.switcher}>{(['Day', 'Week', 'Month'] as const).map(mode => <TouchableOpacity key={mode} style={[s.switchButton, viewMode === mode && s.switchActive]} onPress={() => mode === 'Month' ? onOpenMonth?.() : setViewMode(mode)}><Text style={[s.switchText, viewMode === mode && s.switchTextActive]}>{mode}</Text></TouchableOpacity>)}</View>
        <View style={s.weekControls}><TouchableOpacity onPress={() => changeWeek(-1)} style={s.weekArrow}><Text style={s.weekArrowText}>‹</Text></TouchableOpacity><Text style={s.weekTitle}>{weekDays[0].toLocaleDateString('en-US', { month: 'short', day: 'numeric' })} – {weekDays[6].toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</Text><TouchableOpacity onPress={() => changeWeek(1)} style={s.weekArrow}><Text style={s.weekArrowText}>›</Text></TouchableOpacity></View>
        <View style={s.weekRow}>{weekDays.map(date => { const selected = dateKey(date) === selectedKey; return <TouchableOpacity key={dateKey(date)} style={[s.dayButton, selected && s.daySelected]} onPress={() => setSelectedDate(date)}><Text style={[s.dayText, selected && s.white]}>{date.toLocaleDateString('en-US', { weekday: 'short' }).slice(0, 1)}</Text><Text style={[s.dayNumber, selected && s.white]}>{date.getDate()}</Text></TouchableOpacity>; })}</View>
        <View style={s.summary}><View><Text style={s.eyebrow}>YOUR SCHEDULE</Text><Text style={s.summaryTitle}>{blocks.length} planned blocks</Text></View><View style={s.donePill}><Text style={s.doneText}>{completed} done</Text></View></View>
        <TouchableOpacity style={s.aiCard} onPress={onOpenAI}><Text style={s.aiSymbol}>✦</Text><View style={{ flex: 1 }}><Text style={s.bold}>Need a little help planning?</Text><Text style={s.muted}>Ask Flux AI about priorities and your schedule.</Text></View><Text style={s.arrow}>›</Text></TouchableOpacity>
        <Text style={s.section}>{selectedKey === todayKey ? "Today's schedule" : `Schedule for ${readableDate(selectedKey)}`}</Text>
        {viewMode === 'Week' ? weekDays.map(date => {
            const dayClasses = classes.filter(c => meets(c, date));
            const dayCommitments = commitments.filter(c => commitmentMeets(c, date));
            return <View key={dateKey(date)} style={s.weekDayCard}><TouchableOpacity onPress={() => { setSelectedDate(date); setViewMode('Day'); }}><Text style={s.weekDayHeading}>{date.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' })} ›</Text></TouchableOpacity>
                {dayClasses.map(c => <View key={c.id} style={[s.periodCard, { backgroundColor: c.color || colors.blocks.blue }]}><Text style={s.bold}>{c.period} · {c.name}</Text>{classItems(c.id).map(item => <View key={item.id} style={s.miniAssignment}><TouchableOpacity onPress={() => onToggleItem?.(item.id)} style={[s.checkbox, item.completed && s.checked]}>{item.completed && <Text style={s.check}>✓</Text>}</TouchableOpacity><TouchableOpacity style={{ flex: 1 }} onPress={() => item.type === 'test' ? onOpenTest?.(c.name, item.title) : onOpenAssignment?.(item.title, c.name)}><Text style={s.assignmentTitle}>{item.type === 'test' ? 'TEST · ' : ''}{item.title}</Text><Text style={s.muted}>Due {readableDate(item.dueDate)} {item.id.startsWith('fluxup-demo-') ? '· SAMPLE' : ''}</Text></TouchableOpacity></View>)}</View>)}
                {dayCommitments.map(c => <Text key={c.id} style={s.weekCommitment}>✦ {c.name} · {c.startTime}</Text>)}
                {!dayClasses.length && !dayCommitments.length && <Text style={s.muted}>No scheduled blocks</Text>}
            </View>;
        }) : blocks.map(b => <View key={b.id} style={s.timeline}>
            <View style={s.timeColumn}><Text style={s.muted}>{b.time === 'Time not set' ? (b.isClass ? b.subtitle : '') : b.time.split('–')[0].trim()}</Text><View style={s.line} /></View>
            <View style={{ flex: 1 }}><View style={[s.periodCard, { backgroundColor: b.color || colors.blocks.blue }]}>
                <TouchableOpacity disabled={!b.isClass} onPress={() => onOpenClass?.(b.title)}><Text style={s.bold}>{b.title}</Text><Text style={s.muted}>{b.subtitle}{b.time !== 'Time not set' ? ` · ${b.time}` : ''}</Text></TouchableOpacity>
                {b.isClass && classItems(b.classId).map(item => <View key={item.id} style={s.miniAssignment}>
                    <TouchableOpacity style={[s.checkbox, item.completed && s.checked]} onPress={() => onToggleItem?.(item.id)}>{item.completed && <Text style={s.check}>✓</Text>}</TouchableOpacity>
                    <TouchableOpacity style={{ flex: 1 }} onPress={() => item.type === 'test' ? onOpenTest?.(b.title, item.title) : onOpenAssignment?.(item.title, b.title)}><Text style={[s.assignmentTitle, item.completed && s.struck]}>{item.type === 'test' ? 'TEST · ' : ''}{item.title}</Text><Text style={s.muted}>Due {readableDate(item.dueDate)} · {item.priority}{item.id.startsWith('fluxup-demo-') ? ' · SAMPLE' : ''}</Text></TouchableOpacity>
                </View>)}
            </View></View>
        </View>)}
        {viewMode === 'Day' && blocks.length === 0 && <View style={s.empty}><Text style={s.bold}>{selectedDate.getDay() === 0 || selectedDate.getDay() === 6 ? 'No school periods this weekend' : 'No class periods today'}</Text><Text style={s.muted}>Your assignments remain attached to their class periods on school days.</Text></View>}
        {plannerItems.filter(i => i.type === 'event' && i.dueDate === selectedKey).map(e => <View key={e.id} style={s.event}><Text style={s.bold}>{e.title}</Text><Text style={s.muted}>{e.notes || 'Personal event'}</Text></View>)}
        <TouchableOpacity style={[s.manage, { marginTop: 20 }]} onPress={onAddItem}><Text style={s.aiSymbol}>＋</Text><View style={{ flex: 1 }}><Text style={s.bold}>Add an assignment or task</Text><Text style={s.muted}>It will appear inside its selected class period.</Text></View><Text style={s.arrow}>›</Text></TouchableOpacity>
        <View style={s.focus}><Text style={s.aiSymbol}>✦</Text><View style={{ flex: 1 }}><Text style={s.bold}>A little focus time?</Text><Text style={s.muted}>Use an available study block to make progress on your next deadline.</Text></View></View>
        <Text style={[s.section, { marginTop: 30 }]}>Manage your schedule</Text><TouchableOpacity style={s.manage} onPress={onEditClasses}><Text style={s.aiSymbol}>▤</Text><View style={{ flex: 1 }}><Text style={s.bold}>Add or edit classes</Text><Text style={s.muted}>Manage subjects, periods, and teachers</Text></View><Text style={s.arrow}>›</Text></TouchableOpacity><TouchableOpacity style={s.manage} onPress={onEditCommitments}><Text style={s.aiSymbol}>✦</Text><View style={{ flex: 1 }}><Text style={s.bold}>Add or edit extracurriculars</Text><Text style={s.muted}>Update clubs and weekly commitments</Text></View><Text style={s.arrow}>›</Text></TouchableOpacity>
        <Text style={s.footer}>Your plan can change. Flux can help you adjust.</Text>
    </ScrollView><TouchableOpacity style={s.aiButton} onPress={onOpenAI}><Text style={s.addText}>✦ Ask Flux AI</Text></TouchableOpacity><View style={s.nav}><TouchableOpacity style={s.navItem}><Text style={s.navActive}>▦</Text><Text style={s.navActive}>Planner</Text></TouchableOpacity><TouchableOpacity style={s.navItem} onPress={onOpenTasks}><Text style={s.navIcon}>✓</Text><Text style={s.navLabel}>Tasks</Text></TouchableOpacity><TouchableOpacity style={s.navItem} onPress={onAddItem}><Text style={s.navIcon}>＋</Text><Text style={s.navLabel}>Add</Text></TouchableOpacity><TouchableOpacity style={s.navItem} disabled><Text style={s.navIcon}>◷</Text><Text style={s.navLabel}>Focus</Text></TouchableOpacity></View></View>;
}
const s = StyleSheet.create({
    weekControls: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', marginBottom: 8 }, weekArrow: { paddingHorizontal: 15, paddingVertical: 5 }, weekArrowText: { fontSize: 28, color: colors.brand.primary, fontWeight: '700' }, weekTitle: { fontSize: 13, fontWeight: '800', color: colors.text.primary }, weekDayCard: { backgroundColor: colors.surface, borderRadius: 15, padding: 14, marginBottom: 12, borderWidth: 1, borderColor: colors.border }, weekDayHeading: { fontSize: 14, fontWeight: '800', color: colors.brand.dark, marginBottom: 10 }, weekCommitment: { color: colors.text.primary, fontSize: 12, marginTop: 6 }, periodCard: { borderRadius: 16, padding: 13, marginBottom: 4 }, miniAssignment: { flexDirection: 'row', alignItems: 'center', gap: 9, backgroundColor: 'rgba(255,255,255,0.32)', borderRadius: 10, padding: 9, marginTop: 9 },
    screen: { flex: 1, backgroundColor: colors.background }, content: { width: '100%', maxWidth: 760, alignSelf: 'center', paddingHorizontal: 24, paddingTop: 26, paddingBottom: 120 }, header: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 30 }, logo: { fontSize: 30, fontWeight: '800', color: colors.brand.primary }, avatar: { width: 42, height: 42, borderRadius: 21, backgroundColor: colors.brand.light, alignItems: 'center', justifyContent: 'center' }, avatarText: { color: colors.brand.dark, fontWeight: '800' }, eyebrow: { color: colors.text.secondary, fontSize: 10, fontWeight: '800', letterSpacing: 1.2, marginBottom: 8 }, title: { fontSize: 31, fontWeight: '800', color: colors.text.primary }, subtitle: { fontSize: 14, color: colors.text.secondary, marginTop: 8, marginBottom: 24 }, switcher: { flexDirection: 'row', padding: 4, backgroundColor: '#F0F3EF', borderRadius: 14, marginBottom: 20 }, switchButton: { flex: 1, alignItems: 'center', paddingVertical: 11, borderRadius: 11 }, switchActive: { backgroundColor: colors.surface }, switchText: { color: colors.text.secondary, fontWeight: '600' }, switchTextActive: { color: colors.brand.dark, fontWeight: '800' }, weekRow: { flexDirection: 'row', justifyContent: 'space-between', marginBottom: 23 }, dayButton: { flex: 1, paddingVertical: 12, borderRadius: 14, alignItems: 'center', gap: 8 }, daySelected: { backgroundColor: colors.brand.primary }, dayText: { color: colors.text.secondary, fontSize: 11 }, dayNumber: { color: colors.text.primary, fontWeight: '800' }, white: { color: '#FFF' }, summary: { backgroundColor: colors.surface, borderWidth: 1, borderColor: colors.border, borderRadius: 18, padding: 19, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', marginBottom: 20 }, summaryTitle: { fontSize: 19, fontWeight: '800', color: colors.text.primary }, donePill: { backgroundColor: colors.brand.light, borderRadius: 12, padding: 11 }, doneText: { color: colors.brand.dark, fontSize: 12, fontWeight: '800' }, aiCard: { flexDirection: 'row', alignItems: 'center', backgroundColor: '#EAF5EE', borderRadius: 17, padding: 16, marginBottom: 28, gap: 12 }, aiSymbol: { fontSize: 25, color: colors.brand.primary }, bold: { color: colors.text.primary, fontSize: 14, fontWeight: '800', marginBottom: 4 }, muted: { color: colors.text.secondary, fontSize: 11, lineHeight: 18, marginTop: 3 }, arrow: { color: colors.brand.dark, fontSize: 22 }, section: { fontSize: 19, fontWeight: '800', color: colors.text.primary, marginBottom: 12 }, timeline: { flexDirection: 'row', marginBottom: 12 }, timeColumn: { width: 76, paddingTop: 15 }, line: { width: 1, flex: 1, minHeight: 50, backgroundColor: colors.border, marginTop: 10 }, scheduleCard: { flex: 1, borderRadius: 17, padding: 16 }, empty: { backgroundColor: colors.surface, borderWidth: 1, borderColor: colors.border, borderRadius: 16, padding: 18, marginBottom: 22 }, event: { backgroundColor: colors.blocks.yellow, borderRadius: 15, padding: 17, marginBottom: 12 }, classHeading: { flexDirection: 'row', alignItems: 'center', marginTop: 25, marginBottom: 14, gap: 12 }, addButton: { backgroundColor: colors.brand.primary, borderRadius: 12, paddingHorizontal: 14, paddingVertical: 10 }, addText: { color: '#FFF', fontWeight: '800', fontSize: 12 }, courseCard: { backgroundColor: colors.surface, borderWidth: 1, borderColor: colors.border, borderRadius: 17, marginBottom: 13, overflow: 'hidden' }, courseHeader: { flexDirection: 'row', alignItems: 'center', padding: 15, gap: 12 }, indicator: { width: 7, height: 43, borderRadius: 5 }, noItems: { fontSize: 11, color: colors.text.muted, paddingHorizontal: 17, paddingBottom: 16 }, assignment: { flexDirection: 'row', alignItems: 'center', paddingHorizontal: 16, paddingVertical: 13, gap: 11, borderTopWidth: 1, borderTopColor: colors.divider }, checkbox: { width: 20, height: 20, borderWidth: 1.4, borderColor: '#71827A', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }, checked: { backgroundColor: colors.brand.primary, borderColor: colors.brand.primary }, check: { color: '#FFF', fontWeight: '800' }, assignmentTitle: { fontSize: 12, fontWeight: '700', color: colors.text.primary }, struck: { textDecorationLine: 'line-through', color: colors.text.muted }, sample: { fontSize: 9, fontWeight: '800', color: colors.brand.primary, marginTop: 5, letterSpacing: 1 }, focus: { flexDirection: 'row', alignItems: 'center', backgroundColor: '#E3F3E8', borderRadius: 18, padding: 18, marginTop: 18, gap: 13 }, manage: { flexDirection: 'row', alignItems: 'center', backgroundColor: colors.surface, borderWidth: 1, borderColor: colors.border, borderRadius: 16, padding: 16, marginBottom: 11, gap: 12 }, footer: { color: colors.text.muted, textAlign: 'center', fontSize: 11, marginTop: 25 }, aiButton: { position: 'absolute', right: 20, bottom: 85, backgroundColor: colors.brand.primary, borderRadius: 30, paddingHorizontal: 20, paddingVertical: 15, elevation: 5, zIndex: 10 }, nav: { flexDirection: 'row', justifyContent: 'space-around', backgroundColor: colors.surface, borderTopWidth: 1, borderTopColor: colors.border, paddingTop: 12, paddingBottom: 10 }, navItem: { alignItems: 'center', minWidth: 55, gap: 4 }, navIcon: { color: colors.text.muted, fontSize: 21 }, navActive: { color: colors.brand.primary, fontSize: 13, fontWeight: '800' }, navLabel: { color: colors.text.muted, fontSize: 10 }
});
